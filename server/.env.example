PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/elearning
CLIENT_URL=http://localhost:5173

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional, defaults to a value derived from JWT_SECRET
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m

GOOGLE_CLIENT_ID=
ELASTICSEARCH_NODE=http://127.0.0.1:9200

# Optional: caching + BullMQ queues (falls back gracefully when Redis is down)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: real emails (without SMTP_HOST, emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=E-Learning <no-reply@example.com>

# PayPal (without these, checkout runs in demo mode)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_ID=
# Webhook id from the PayPal dashboard, used to verify webhook signatures
PAYPAL_WEBHOOK_ID=
# Local testing only: accept unsigned webhook events (ignored in production)
PAYPAL_WEBHOOK_ALLOW_UNVERIFIED=false

LOG_LEVEL=info
